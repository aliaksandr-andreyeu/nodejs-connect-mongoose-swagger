# Copy to .env.development for local development.
DB_HOST=localhost
DB_PORT=27017
DB_NAME=app
DB_USER=app
DB_PSW=appsecret
HOST=localhost
PORT=3000
ACCESS_TOKEN_KEY=change-me-access-token-secret
ACCESS_TOKEN_EXPIRES_IN=5
REFRESH_TOKEN_KEY=change-me-refresh-token-secret
REFRESH_TOKEN_EXPIRES_IN=60
RESPONSE_DELAY=0
BCRYPT_ROUNDS=12
MAX_BODY_BYTES=1048576
TRUST_PROXY=false
RESET_TOKEN_TTL_MIN=15
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password
REDIS_ENABLED=true
REDIS_USER_CACHE_TTL_SEC=60
RATE_LIMIT_AUTH_POINTS=10
RATE_LIMIT_AUTH_DURATION_SEC=60
RATE_LIMIT_ENABLED=false
