{
  "name": "nodejs-connect-mongoose-swagger",
  "version": "0.2.0",
  "private": true,
  "description": "Node.js REST API boilerplate with Connect, Mongoose, Swagger",
  "keywords": [],
  "author": {
    "name": "Aliaksandr Andreyeu",
    "email": "andreyeu.aliaksandr@gmail.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/aliaksandr-andreyeu/nodejs-connect-mongoose-swagger",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aliaksandr-andreyeu/nodejs-connect-mongoose-swagger.git"
  },
  "main": "build/index.js",
  "scripts": {
    "postinstall": "npx typesync && npm run setup:swagger-ui",
    "precommit": "lint-staged",
    "prepare": "husky install",
    "clean:build": "rimraf build",
    "openapi:generate": "cross-env NODE_ENV=development tsx src/scripts/generate-openapi.ts",
    "setup:swagger-ui": "tsx src/scripts/setup-swagger-ui.ts",
    "copy:public": "mkdir -p build/public && cp -R src/public/. build/public/",
    "docker:up": "docker compose --env-file .env.development up -d",
    "docker:down": "docker compose --env-file .env.development down",
    "docker:logs": "docker compose logs -f mongodb redis",
    "test:unit": "jest --config jest.unit.config.json --coverage",
    "test:e2e": "jest --config jest.e2e.config.json --coverage",
    "test": "npm run test:unit",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"./**/*.{html,css,json,js,ts}\"",
    "lint": "npm run format && npm run lint:ts",
    "lint:ts": "eslint \"./**/*.ts\"",
    "lint:ts:fix": "eslint --fix \"./**/*.ts\"",
    "lint:fix": "npm run format && npm run lint:ts:fix",
    "build:prod": "npm run setup:swagger-ui && npm run clean:build && npm run lint:fix && npm run openapi:generate && tsc && tsc-alias && npm run copy:public",
    "start:dev": "cross-env NODE_ENV=development nodemon --exec tsx src/index.ts",
    "start:prod": "npm run build:prod && cross-env NODE_ENV=production node ./build/index.js"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.0",
    "bcrypt": "^5.1.0",
    "compression": "^1.7.4",
    "connect": "^3.7.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "etag": "^1.8.1",
    "express-mongo-sanitize": "^2.2.0",
    "helmet": "^6.0.1",
    "hpp": "^0.2.3",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.0",
    "mime-types": "^2.1.35",
    "mongoose": "^8.9.5",
    "pino": "^9.9.5",
    "rate-limiter-flexible": "^7.4.0",
    "uuid": "^9.0.0",
    "xss": "^1.0.15",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/connect": "^3.4.38",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/eslint": "~9.6.1",
    "@types/eslint-config-prettier": "~6.11.3",
    "@types/eslint-plugin-prettier": "~3.1.3",
    "@types/etag": "~1.8.4",
    "@types/hpp": "~0.2.7",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^22.20.0",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.62.1",
    "cross-env": "^7.0.3",
    "eslint": "^8.32.0",
    "eslint-config-prettier": "^8.6.0",
    "eslint-plugin-jest": "^27.2.1",
    "eslint-plugin-prettier": "^4.2.1",
    "husky": "^8.0.3",
    "jest": "^29.5.0",
    "lint-staged": "^13.1.0",
    "mongodb-memory-server": "^10.2.0",
    "nodemon": "^2.0.20",
    "prettier": "^2.8.3",
    "rimraf": "^4.1.2",
    "supertest": "^7.1.4",
    "swagger-ui-dist": "^5.32.6",
    "ts-jest": "^29.2.6",
    "tsc-alias": "^1.8.11",
    "tsx": "^4.23.0",
    "typescript": "^5.8.2",
    "typesync": "^0.14.3"
  }
}
