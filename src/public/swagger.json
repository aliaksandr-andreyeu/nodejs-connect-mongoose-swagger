{
  "openapi": "3.0.0",
  "info": {
    "title": "Node.js Connect Mongoose Swagger API",
    "version": "0.1.0",
    "description": "REST API boilerplate with Connect, Mongoose, and OpenAPI generated from Zod schemas"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Current environment"
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "Authentication operations"
    },
    {
      "name": "Account",
      "description": "Operations with account"
    },
    {
      "name": "Users",
      "description": "Operations with users"
    }
  ],
  "components": {
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Bearer Authentication with JWT"
      },
      "CookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "X-Refresh-Token",
        "description": "Refresh token cookie"
      }
    },
    "schemas": {
      "APIError": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "required": ["message", "status"]
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "surname": {
            "type": "string"
          },
          "isActive": {
            "type": "boolean"
          },
          "job": {
            "type": "string"
          },
          "age": {
            "type": "number"
          }
        },
        "required": ["id", "username"]
      },
      "AuthData": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "overview": {
            "$ref": "#/components/schemas/User"
          }
        },
        "required": ["accessToken", "overview"]
      },
      "AuthResponseBody": {
        "type": "object",
        "properties": {
          "isOk": {
            "type": "boolean"
          },
          "message": {
            "type": "string",
            "nullable": true
          },
          "data": {
            "$ref": "#/components/schemas/AuthData"
          }
        },
        "required": ["isOk", "message"]
      },
      "UserResponseBody": {
        "type": "object",
        "properties": {
          "isOk": {
            "type": "boolean"
          },
          "message": {
            "type": "string",
            "nullable": true
          },
          "data": {
            "$ref": "#/components/schemas/User"
          }
        },
        "required": ["isOk", "message"]
      },
      "UsersListResponseBody": {
        "type": "object",
        "properties": {
          "isOk": {
            "type": "boolean"
          },
          "message": {
            "type": "string",
            "nullable": true
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/User"
            }
          }
        },
        "required": ["isOk", "message"]
      },
      "EmptyResponseBody": {
        "type": "object",
        "properties": {
          "isOk": {
            "type": "boolean"
          },
          "message": {
            "type": "string",
            "nullable": true
          },
          "data": {
            "nullable": true
          }
        },
        "required": ["isOk", "message"]
      },
      "UserIdPathParams": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "User ID"
          }
        },
        "required": ["id"]
      },
      "SignInInput": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "minLength": 1
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 256,
            "pattern": "[a-z]"
          }
        },
        "required": ["username", "password"]
      },
      "SignUpInput": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "minLength": 1
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 256,
            "pattern": "[a-z]"
          }
        },
        "required": ["username", "password"]
      },
      "ResetPasswordInput": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["username"]
      },
      "ContactUsInput": {
        "type": "object",
        "properties": {
          "subject": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["subject", "message"]
      },
      "UserAccountInput": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "surname": {
            "type": "string"
          },
          "age": {
            "type": "number"
          },
          "job": {
            "type": "string"
          }
        },
        "required": ["username"]
      },
      "ChangePasswordInput": {
        "type": "object",
        "properties": {
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 256,
            "pattern": "[a-z]"
          },
          "newpassword": {
            "type": "string",
            "minLength": 8,
            "maxLength": 256,
            "pattern": "[a-z]"
          },
          "confirm": {
            "type": "string",
            "minLength": 8,
            "maxLength": 256,
            "pattern": "[a-z]"
          }
        },
        "required": ["password", "newpassword", "confirm"]
      },
      "UserProfileInput": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "surname": {
            "type": "string"
          },
          "isActive": {
            "type": "boolean"
          },
          "age": {
            "type": "number"
          },
          "job": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 256,
            "pattern": "[a-z]"
          }
        },
        "required": ["username"]
      }
    },
    "parameters": {}
  },
